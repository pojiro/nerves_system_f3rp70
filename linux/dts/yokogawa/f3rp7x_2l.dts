/dts-v1/;
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include "f3rp7x.dtsi"

/ {
 version = "f3rp71_2l.dtb Rev 2.00";

	chosen {
		bootargs = "console=ttyPS0,115200 root=/dev/ram rw earlyprintk";
		linux,stdout-path = "/amba/serial@e0000000";
	};

	aliases {
		ethernet0 = &gem0;
		ethernet1 = &gem1;
		serial0 = &uart0;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		spi0 = &qspi;
		spi1 = &spi0;
	};

	m3io {
		compatible = "ykgw,m3io";
		status = "okay";
		interrupt-parent = <&intc>;
		interrupts = <0 30 4>; /* INUM_BIC_IO (62 = 30 + 32) */
	};

	m3cpu {
		compatible = "ykgw,m3cpu";
		status = "okay";
		interrupt-parent = <&intc>;
		interrupts = <0 31 4>; /* INUM_BIC_CMD (63 = 31 + 32) */
	};

	m3ras {
		compatible = "ykgw,m3ras";
		status = "okay";
		interrupt-parent = <&intc>;
		interrupts = <0 29 4>, /* INUM_BIC_FAIL (61 = 29 + 32) */
		             <0 54 4>; /* INUM_PL_MISC (86 = 54 + 32) */
	};

	memory {
		device_type = "memory";
		reg = <0x0 0x40000000>;
	};

	amba {
		bic_axi_0: bic-axi@40000000 {
			#address-cells = <1>;
			#size-cells = <1>;
			compatible = "xlnx,bic-axi-2.0";
			ranges = <0x40000000 0x40000000 0x200000 0x40000000 0x40000000 0x200000>;
			xlnx,align-be-rdaddr = <0x1>;
			xlnx,include-timeout-cnt = <0x0>;
			xlnx,rdata-fifo-depth = <0x20>;
			xlnx,s-axi-id-width = <0xc>;
			xlnx,s-axi-supports-read = <0x1>;
			xlnx,s-axi-supports-write = <0x1>;
			xlnx,timeout-cntr-val = <0x8>;
		};

		pl_int_ctrl_0: pl-int-ctrl@48000000 {
			compatible = "xlnx,pl-int-ctrl-1.0";
			reg = <0x48000000 0x1000>;
			xlnx,dphase-timeout = <0x0>;
			xlnx,num-mem = <0x1>;
			xlnx,num-reg = <0x1>;
			xlnx,s-axi-min-size = <0x1ff>;
			xlnx,slv-awidth = <0x20>;
			xlnx,slv-dwidth = <0x20>;
			xlnx,use-wstrb = <0x1>;
		};

		rtc_ctrl_0: rtc-ctrl@48001000 {
			compatible = "ykgw,rtc-ctrl-1.0";
			reg = <0x48001000 0x1000>;
		};

		led_ctrl_0: led-ctrl@48002000 {
			compatible = "xlnx,led-ctrl-1.0";
			reg = <0x48002000 0x1000>;
			xlnx,dphase-timeout = <0x0>;
			xlnx,i2c-addr = <0x20>;
			xlnx,num-mem = <0x1>;
			xlnx,num-reg = <0x1>;
			xlnx,period = <0xc350>;
			xlnx,period2 = <0x9>;
			xlnx,s-axi-min-size = <0xfff>;
			xlnx,slv-awidth = <0x20>;
			xlnx,slv-dwidth = <0x20>;
			xlnx,use-wstrb = <0x1>;
		};

		selfrst_gen_0: selfrst-gen@48003000 {
			compatible = "xlnx,selfrst-gen-1.0";
			reg = <0x48003000 0x1000>;
		};

		misc_reg_0: misc-reg@4800f000 {
			compatible = "xlnx,misc-reg-1.0";
			reg = <0x4800f000 0x1000>;
			xlnx,dphase-timeout = <0x0>;
			xlnx,num-mem = <0x1>;
			xlnx,num-reg = <0x1>;
			xlnx,rev = <0x3032>;
			xlnx,s-axi-min-size = <0xfff>;
			xlnx,slv-awidth = <0x20>;
			xlnx,slv-dwidth = <0x20>;
			xlnx,typ = <0x42>;
			xlnx,use-wstrb = <0x1>;
		};

		xadc_wiz_0: xadc-wiz@50000000 {
			compatible = "xlnx,xadc-wiz-3.0";
			reg = <0x50000000 0x1000>;
		};

		tsensor_ctrl_0: tsensor-ctrl@50001000 {
			compatible = "xlnx,tsensor-ctrl-1.0";
			reg = <0x50001000 0x1000>;
		};

		microblaze_0_local_memory_dlmb_bram_if_cntlr: lmb-bram-if-cntlr@0 {
			#address-cells = <1>;
			#size-cells = <1>;
			compatible = "xlnx,lmb-bram-if-cntlr-4.0";
			ranges = <0x0 0x0 0x8000 0x50003000 0x50003000 0x1000>;
			xlnx,ce-counter-width = <0x8>;
			xlnx,ce-failing-registers = <0x1>;
			xlnx,ecc = <0x1>;
			xlnx,ecc-onoff-register = <0x0>;
			xlnx,ecc-onoff-reset-value = <0x1>;
			xlnx,ecc-status-registers = <0x1>;
			xlnx,fault-inject = <0x1>;
			xlnx,interconnect = <0x2>;
			xlnx,lmb-awidth = <0x20>;
			xlnx,lmb-dwidth = <0x20>;
			xlnx,mask = <0x40000000>;
			xlnx,mask1 = <0x800000>;
			xlnx,mask2 = <0x800000>;
			xlnx,mask3 = <0x800000>;
			xlnx,num-lmb = <0x1>;
			xlnx,s-axi-ctrl-addr-width = <0x20>;
			xlnx,s-axi-ctrl-data-width = <0x20>;
			xlnx,s-axi-ctrl-protocol = "AXI4LITE";
			xlnx,ue-failing-registers = <0x1>;
			xlnx,write-access = <0x2>;
		};

		microblaze_0_local_memory_ilmb_bram_if_cntlr: lmb-bram-if-cntlr@1 {
			#address-cells = <1>;
			#size-cells = <1>;
			compatible = "xlnx,lmb-bram-if-cntlr-4.0";
			ranges = <0x0 0x0 0x8000 0x50002000 0x50002000 0x1000>;
			xlnx,ce-counter-width = <0x8>;
			xlnx,ce-failing-registers = <0x1>;
			xlnx,ecc = <0x1>;
			xlnx,ecc-onoff-register = <0x0>;
			xlnx,ecc-onoff-reset-value = <0x1>;
			xlnx,ecc-status-registers = <0x1>;
			xlnx,fault-inject = <0x1>;
			xlnx,interconnect = <0x2>;
			xlnx,lmb-awidth = <0x20>;
			xlnx,lmb-dwidth = <0x20>;
			xlnx,mask = <0x0>;
			xlnx,mask1 = <0x800000>;
			xlnx,mask2 = <0x800000>;
			xlnx,mask3 = <0x800000>;
			xlnx,num-lmb = <0x1>;
			xlnx,s-axi-ctrl-addr-width = <0x20>;
			xlnx,s-axi-ctrl-data-width = <0x20>;
			xlnx,s-axi-ctrl-protocol = "AXI4LITE";
			xlnx,ue-failing-registers = <0x1>;
			xlnx,write-access = <0x2>;
		};

		axi_timer_1: timer@50005000 {
			clock-frequency = <100000000>;
			compatible = "xlnx,axi-timer-2.0", "xlnx,xps-timer-1.00.a";
			reg = <0x50005000 0x1000>;
			xlnx,count-width = <0x20>;
			xlnx,gen0-assert = <0x1>;
			xlnx,gen1-assert = <0x1>;
			xlnx,one-timer-only = <0x1>;
			xlnx,trig0-assert = <0x1>;
			xlnx,trig1-assert = <0x1>;
		};

		axi_bram_ctrl_0: axi-bram-ctrl@51000000 {
			compatible = "xlnx,axi-bram-ctrl-3.0", "xlnx,xps-bram-if-cntlr-1.00.a";
			reg = <0x51000000 0x1000>;
			xlnx,bram-addr-width = <0xa>;
			xlnx,bram-inst-mode = "EXTERNAL";
			xlnx,ecc = <0x1>;
			xlnx,ecc-onoff-reset-value = <0x0>;
			xlnx,ecc-type = <0x0>;
			xlnx,fault-inject = <0x1>;
			xlnx,memory-depth = <0x400>;
			xlnx,s-axi-ctrl-addr-width = <0x20>;
			xlnx,s-axi-ctrl-data-width = <0x20>;
			xlnx,s-axi-id-width = <0x1>;
			xlnx,s-axi-supports-narrow-burst = <0x0>;
			xlnx,single-port-bram = <0x1>;
		};

		nor_flash_0: nor_flash@60000000 {
			bank-width = <2>;
			compatible = "cfi-flash";
			linux,mtd-name = "cfi";
			reg = <0x60000000 0x08000000
			       0x68000000 0x08000000>;
			#address-cells = <1>;
			#size-cells = <1>;
			partition@user {
				 /*256MiB*/
				label = "user";
				reg = <0x0 0x10000000>;
			};
		};

		sram_0: sram@70000000 {
			bank-width = <2>;
			compatible = "mtd-ram";
			reg = <0x70000000 0x00780000>;
			#address-cells = <1>;
			#size-cells = <1>;
			partition@user_sram {
			label = "user sram";
				/*7.5MiB*/
			reg = <0x0 0x00780000>;
			};
		};

		pci_ctrl_0: pci-ctrl@80000000 {
			compatible = "ykgw,pci-ctrl-1.0";
			device_type = "pci";
			reg = <0xb0000000 0x100>;
			reg-names = "config";		/* config register address */
			interrupt-parent = <&intc>;
			interrupts = <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>;	/* 35+32=IRQ67 */
			bus-range = <0x00 0xFF>;
			#address-cells = <3>;
			#size-cells = <2>;
			#interrupt-cells = <1>;
			ranges = <
				0x02000000 0 0x80000000 0x80000000 0 0x20000000 /* Memory 0x8000_0000 - 0x9FFF_FFFF */
				0x01000000 0 0xa0000000 0xa0000000 0 0x10000000 /* I/O    0xA000_0000 - 0xAFFF_FFFF */
				0x00000000 0 0xb0000000 0xb0000000 0 0x00000100 /* Config 0xB000_0000 - 0xB000_00FF */
			>;
			interrupt-map-mask = <0xf800 0 0 0x7>;
			interrupt-map = <
					/* for IDSEL 20 (0x14:UM1) */
					0xA000 0 0 1 &intc 0 55 IRQ_TYPE_LEVEL_HIGH /* UM1 INT1 to 55+32=IRQ87 */
					0xA000 0 0 2 &intc 0 56 IRQ_TYPE_LEVEL_HIGH /* UM1 INT2 to 56+32=IRQ88 */
					0xA000 0 0 3 &intc 0 57 IRQ_TYPE_LEVEL_HIGH /* UM1 INT3 to 57+32=IRQ89 */
					0xA000 0 0 4 &intc 0 58 IRQ_TYPE_LEVEL_HIGH /* UM1 INT4 to 58+32=IRQ90 */
					/* for IDSEL 21 (0x15:UM2) */
					0xA800 0 0 1 &intc 0 56 IRQ_TYPE_LEVEL_HIGH /* UM2 INT1 to 56+32=IRQ88 */
					0xA800 0 0 2 &intc 0 57 IRQ_TYPE_LEVEL_HIGH /* UM2 INT2 to 57+32=IRQ89 */
					0xA800 0 0 3 &intc 0 58 IRQ_TYPE_LEVEL_HIGH /* UM2 INT3 to 58+32=IRQ90 */
					0xA800 0 0 4 &intc 0 55 IRQ_TYPE_LEVEL_HIGH /* UM2 INT4 to 55+32=IRQ87 */
					/* for IDSEL 22 (0x16:UM3) */
					0xB000 0 0 1 &intc 0 57 IRQ_TYPE_LEVEL_HIGH /* UM3 INT1 to 57+32=IRQ89 */
					0xB000 0 0 2 &intc 0 58 IRQ_TYPE_LEVEL_HIGH /* UM3 INT2 to 58+32=IRQ90 */
					0xB000 0 0 3 &intc 0 55 IRQ_TYPE_LEVEL_HIGH /* UM3 INT3 to 55+32=IRQ87 */
					0xB000 0 0 4 &intc 0 56 IRQ_TYPE_LEVEL_HIGH /* UM3 INT4 to 56+32=IRQ88 */
					/* for IDSEL 23 (0x17:UM4) */
					0xB800 0 0 1 &intc 0 58 IRQ_TYPE_LEVEL_HIGH /* UM4 INT1 to 58+32=IRQ90 */
					0xB800 0 0 2 &intc 0 55 IRQ_TYPE_LEVEL_HIGH /* UM4 INT2 to 55+32=IRQ87 */
					0xB800 0 0 3 &intc 0 56 IRQ_TYPE_LEVEL_HIGH /* UM4 INT3 to 56+32=IRQ88 */
					0xB800 0 0 4 &intc 0 57 IRQ_TYPE_LEVEL_HIGH /* UM4 INT4 to 57+32=IRQ89 */
			>;
			xlnx,align-be-rdaddr = <0x0>;
			xlnx,include-timeout-cnt = <0x0>;
			xlnx,rdata-fifo-depth = <0x20>;
			xlnx,s-axi-id-width = <0xc>;
			xlnx,s-axi-supports-read = <0x1>;
			xlnx,s-axi-supports-write = <0x1>;
			xlnx,timeout-cntr-val = <0x8>;
		};
	};
};

&can0 {
	status = "disabled";
};

&can1 {
	status = "disabled";
};

&gpio0 {
	emio-gpio-width = <20>;
	gpio-mask-high = <0>;
	gpio-mask-low = <0x5600>;
	gpio-line-names = "UM_GPIO3","","","","","","","","","UM_GPIO5",
			 "","","UM_GPIO4","UM_GPIO6","","","ROTSW0","ROTSW1","ROTSW2","ROTSW3",
			 "","","XPUSHSW","","","","","","UM_GPIO0","UM_GPIO1",
			 "UM_GPIO2","","","","","","","","","",
			 "","","","","","","","","","",
			 "","","","","","","","","","",
			 "","","","","","","","","","",
			 "","","","","","","","","","",
			 "","","","","","","","","","",
			 "","","","","","","","","","",
			 "","","","","","","","","","",
			 "","","","","","","","";
};

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;
};

&i2c1 {
	status = "okay";
	clock-frequency = <400000>;
};

&uart0 {
	status = "okay";
};

&spi0 {
	status = "okay";
	num-cs = <4>;

	spidev@0 {
		compatible = "xlnx,zynq-spi-r1p6";
		spi-max-frequency = <25000000>;
		reg = <0>;
	};
};

&qspi {
	status = "okay";
	is-dual = <0>;
	num-cs = <1>;
	flash@0 {
		compatible = "n25q128a13";
		reg = <0x0>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;
		spi-max-frequency = <50000000>;
		#address-cells = <1>;
		#size-cells = <1>;
		partition@ff0000 {
			label = "reserved";
			reg = <0x00ff0000 0x00010000>;
			read-only;
		};
	};
};

&gem0 {
	compatible = "xlnx,zynq-gem";
	reg = <0xe000b000 0x1000>;
	status = "okay";
	interrupts = <0 22 4>;
	clocks = <&clkc 30>, <&clkc 30>, <&clkc 13>;
	clock-names = "pclk", "hclk", "tx_clk";

	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy0>;

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		/* Micrel KSZ9031 Gigabit PHY */
		ethernet_phy0: ethernet-phy@3 {
			reg = <3>;
		};

		gmiitorgmii_ethernet_phy0: gmiitorgmii@30 {
			compatible = "xlnx,gmii-to-rgmii-1.0";
			reg = <30>;
			phy-handle = <&ethernet_phy0>;
		};

		/* Micrel KSZ9031 Gigabit PHY */
		ethernet_phy1: ethernet-phy@7 {
			reg = <7>;
		};
	};
};

&gem1 {
	compatible = "xlnx,zynq-gem";
	reg = <0xe000c000 0x1000>;
	status = "okay";
	interrupts = <0 45 4>;
	clocks = <&clkc 31>, <&clkc 31>, <&clkc 14>;
	clock-names = "pclk", "hclk", "tx_clk";

	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy1>;

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		gmiitorgmii_ethernet_phy1: gmiitorgmii@31 {
			compatible = "xlnx,gmii-to-rgmii-1.0";
			reg = <31>;
			phy-handle = <&ethernet_phy1>;
		};
	};
};

&sdhci1 {
	compatible = "ykgw,sdhci-1.02.a", "arasan,sdhci-8.9a";
	status = "okay";
	clock-frequency = <50000000>;
	interrupts = <0 47 4>, <0 52 1>;
};

&sdhci0 {
	compatible = "ykgw,sdhci-1.02.a", "arasan,sdhci-8.9a";
	status = "disabled";
	clock-frequency = <50000000>;
	interrupts = <0 24 4>, <0 36 1>;
};

